{
	"schemaVersion": 1,
	"id": "fontsys",
	"version": "${version}",
	"name": "Fontsys",
	"description": "Use any font installed on your computer for all in-game text.",
	"authors": [
		"jekitchen"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/fontsys",
		"sources": "https://github.com/jekitchen/mc-fontsys",
		"issues": "https://github.com/jekitchen/mc-fontsys/issues"
	},
	"license": "MIT",
	"icon": "assets/fontsys/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.jekitchen.fontsys.fabric.FontsysFabric"
		],
		"modmenu": [
			"io.github.jekitchen.fontsys.fabric.FontsysModMenu"
		]
	},
	"mixins": [
		"fontsys.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/fontsys",
				"modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/fontsys",
				"modmenu.buymeacoffee": "https://buymeacoffee.com/jekitchen"
			}
		}
	}
}
