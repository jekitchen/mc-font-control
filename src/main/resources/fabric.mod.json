{
	"schemaVersion": 1,
	"id": "fontsys",
	"version": "${version}",
	"name": "Fontsys",
	"description": "Use any font installed on your computer for all in-game text.",
	"authors": [
		"jekitchen"
	],
	"contact": {
		"sources": "https://github.com/jekitchen/fontsys",
		"issues": "https://github.com/jekitchen/fontsys/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.jekitchen.fontsys.fabric.FontsysFabric"
		],
		"modmenu": [
			"io.github.jekitchen.fontsys.fabric.FontsysModMenu"
		]
	},
	"mixins": [
		"fontsys.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
